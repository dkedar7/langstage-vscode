{
  "name": "langstage-vscode",
  "displayName": "LangStage",
  "description": "Chat with your LangGraph agent in VS Code, Cursor, VSCodium and other VS Code-based editors, with or without Copilot. The VS Code stage of the LangStage family.",
  "version": "0.5.0",
  "publisher": "dkedar7",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "activationEvents": [
    "onView:langstage.chat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "langstage",
          "title": "LangStage",
          "icon": "media/langstage.svg"
        }
      ]
    },
    "views": {
      "langstage": [
        {
          "type": "webview",
          "id": "langstage.chat",
          "name": "Chat",
          "contextualTitle": "LangStage"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "langstage.agent",
        "name": "langstage",
        "fullName": "LangStage",
        "description": "Run your LangGraph agent",
        "isSticky": true,
        "commands": [
          {
            "name": "approve",
            "description": "Approve the action the agent is waiting on"
          },
          {
            "name": "reject",
            "description": "Reject the pending action, with an optional reason"
          },
          {
            "name": "respond",
            "description": "Answer the agent's pending request with your text"
          },
          {
            "name": "edit",
            "description": "Approve with edited arguments: a JSON object such as {\"edited_action\": {...}}"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "langstage.panel.focus",
        "title": "Open the LangStage panel",
        "category": "LangStage"
      },
      {
        "command": "langstage.newConversation",
        "title": "New conversation",
        "category": "LangStage",
        "icon": "$(add)"
      },
      {
        "command": "langstage.restartSidecar",
        "title": "Restart the agent",
        "category": "LangStage",
        "icon": "$(debug-restart)"
      },
      {
        "command": "langstage.answerInterrupt",
        "title": "LangStage: Answer the pending interrupt"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "langstage.newConversation",
          "when": "view == langstage.chat",
          "group": "navigation@1"
        },
        {
          "command": "langstage.restartSidecar",
          "when": "view == langstage.chat",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "langstage.answerInterrupt",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "LangStage",
      "properties": {
        "langstage.agentSpec": {
          "type": "string",
          "default": "",
          "description": "Agent spec 'path/to/agent.py:graph' or 'module:graph' to run. Leave empty to fall back to LANGSTAGE_AGENT_SPEC or the project's langstage.toml. (Legacy deepagent.agentSpec is still read as a fallback.)"
        },
        "langstage.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python interpreter used to launch the langstage-vscode sidecar (must have langstage-vscode installed)."
        },
        "deepagent.agentSpec": {
          "type": "string",
          "default": "",
          "description": "DEPRECATED — use langstage.agentSpec.",
          "deprecationMessage": "Renamed to langstage.agentSpec."
        },
        "deepagent.pythonPath": {
          "type": "string",
          "default": "",
          "description": "DEPRECATED — use langstage.pythonPath.",
          "deprecationMessage": "Renamed to langstage.pythonPath."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && tsc -p webview && node esbuild.mjs",
    "build": "npm run compile",
    "watch": "tsc -watch -p ./",
    "watch:webview": "node esbuild.mjs --watch",
    "test": "npm run compile && node esbuild.mjs --tests && node --test \"dist/test/**/*.test.js\"",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "preact": "^10.29.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.4.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dkedar7/langstage-vscode"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "LangStage runs your configured agent, which executes workspace code."
    },
    "virtualWorkspaces": false
  }
}
